# Скопируйте в .env и замените пароли/секреты.

# Порт, на котором откроется сайт: http://localhost:8080
HTTP_PORT=8080
APP_PUBLIC_URL=http://localhost:8080

# PostgreSQL
POSTGRES_DB=greenleaf
POSTGRES_USER=greenleaf
POSTGRES_PASSWORD=change-me-postgres

# Redis (кеш каталога, корзины, лимиты, отзыв токенов)
REDIS_PASSWORD=change-me-redis

# Секрет подписи JWT — минимум 32 символа. Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# true, когда сайт работает по HTTPS
REFRESH_COOKIE_SECURE=false

# Первый администратор (создаётся при первом запуске, если такого email ещё нет)
ADMIN_EMAIL=admin@greenleaf.kz
ADMIN_PASSWORD=Admin12345
ADMIN_NAME=Администратор

# Импорт каталога из ./seed при пустой базе
SEED_ENABLED=true

# Откуда фронтенд может обращаться к API (адрес сайта и dev-сервер Vite)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Swagger UI на бэкенде (/swagger-ui). Через nginx наружу не публикуется.
API_DOCS_ENABLED=false

# Контакты магазина
STORE_PHONE=+77076173928
STORE_WHATSAPP=77076173928
STORE_TELEGRAM_URL=https://t.me/+5NLkt7yDuxJlZTUy
STORE_INSTAGRAM_URL=
STORE_CITY="г. Алматы"
STORE_ADDRESS="ул. Бонапарта 5"

# Видео о компании на главной по умолчанию (в админке «Настройки сайта» его можно заменить)
COMPANY_VIDEO_URL=https://www.youtube.com/watch?v=1g-BeW0y_TE
COMPANY_VIDEO_TITLE="История Greenleaf, 25 лет на рынке Китая"

# Цены
PARTNER_DISCOUNT_PERCENT=50
DELIVERY_FEE=1500
FREE_DELIVERY_THRESHOLD=25000
