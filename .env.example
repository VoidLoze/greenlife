# Скопируйте в .env и замените пароли/секреты.

# Порт, на котором откроется сайт: http://localhost:8080
HTTP_PORT=8080
# Адрес сайта, как его видят покупатели (на сервере: https://ваш-домен.kz). Он же всегда разрешён в CORS.
APP_PUBLIC_URL=http://localhost:8080
# 127.0.0.1 — если перед сайтом стоит HTTPS-прокси на этом же сервере (тогда порт не виден из интернета)
HTTP_BIND=0.0.0.0
# Подсеть HTTPS-прокси, которому можно верить в заголовке X-Forwarded-For (прокси на хосте: 172.16.0.0/12)
TRUSTED_PROXY=127.0.0.1/32

# PostgreSQL
POSTGRES_DB=greenleaf
POSTGRES_USER=greenleaf
POSTGRES_PASSWORD=

# Redis (кеш каталога, корзины, лимиты, отзыв токенов)
REDIS_PASSWORD=

# Секрет подписи JWT — минимум 32 символа. Сгенерировать: openssl rand -base64 48
# Сайт не запустится со значением-примером.
JWT_SECRET=
# true на настоящем домене с HTTPS (по умолчанию). false — только для локального http://localhost
REFRESH_COOKIE_SECURE=true

# Первый администратор (создаётся при первом запуске, если такого email ещё нет).
# Пароль: от 8 символов, буквы и цифры, НЕ из примеров — со слабым паролем администратор не создаётся.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Администратор
# true — при каждом запуске пароль администратора приводится к ADMIN_PASSWORD (так его меняют)
ADMIN_SYNC_PASSWORD=false

# Импорт каталога из ./seed при пустой базе
SEED_ENABLED=true

# Откуда фронтенд может обращаться к API (адрес сайта и dev-сервер Vite)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Swagger UI на бэкенде (/swagger-ui). Через nginx наружу не публикуется.
API_DOCS_ENABLED=false

# Контакты магазина
STORE_PHONE=+77076173928
STORE_WHATSAPP=77076173928
STORE_TELEGRAM_URL=https://t.me/+5NLkt7yDuxJlZTUy
STORE_INSTAGRAM_URL=
STORE_CITY="г. Алматы"
STORE_ADDRESS="ул. Бонапарта 5"

# Видео о компании на главной по умолчанию (в админке «Настройки сайта» его можно заменить)
COMPANY_VIDEO_URL=https://www.youtube.com/watch?v=1g-BeW0y_TE
COMPANY_VIDEO_TITLE="История Greenleaf, 25 лет на рынке Китая"

# Цены
PARTNER_DISCOUNT_PERCENT=50
DELIVERY_FEE=1500
FREE_DELIVERY_THRESHOLD=7000
FREE_DELIVERY_RETAIL_ONLY=true

# Защита от фейковых заказов: сколько неподтверждённых заказов может быть на один телефон,
# и через сколько часов неподтверждённый заказ отменяется сам (0 — никогда)
OPEN_ORDERS_PER_PHONE=3
AUTO_CANCEL_NEW_AFTER_HOURS=0

# Уведомления о новых заказах в Telegram (можно задать и в админке → «Настройки сайта»)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Резервные копии базы и фото в папку ./backups
# Включить: COMPOSE_PROFILES=backup и `docker compose up -d`. Пусто — копии не делаются.
COMPOSE_PROFILES=backup
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# Копия в облако (Яндекс Диск или любое хранилище с WebDAV). Пусто — только локальная папка ./backups.
# Яндекс Диск: адрес https://webdav.yandex.ru, логин — адрес почты Яндекса, пароль — «пароль приложения»
# (id.yandex.ru → Безопасность → Пароли приложений → Файлы WebDAV). Обычный пароль от почты не подойдёт.
BACKUP_WEBDAV_URL=
BACKUP_WEBDAV_USER=
BACKUP_WEBDAV_PASSWORD=
# Папка на диске и сколько дней хранить там копии базы (фото не удаляются)
BACKUP_REMOTE_DIR=greenleaf-backups
BACKUP_REMOTE_KEEP_DAYS=60
